<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="RR003 test fixtures">
        <provider android:name="radio.reply.catalog.FixtureDocumentsProvider"
            android:authorities="radio.reply.prototype.test.documents" android:exported="true"
            android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <activity android:name="radio.reply.catalog.FixtureGrantActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>
</manifest>
